# Copy to .env.local and fill locally. Never commit populated values.

# Browser-safe Supabase connection values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key used by admin/API routes.
# Use the current Supabase secret key as the value. Never add NEXT_PUBLIC_ here.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URLs. Set these to the deployed URL in Vercel.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=
APP_BASE_URL=
IAM_PORTAL_BASE_URL=

# Production secrets. Generate independent values; keep encryption keys stable.
CRON_SECRET=
COMMS_ENCRYPTION_KEY=
COMPLIANCE_VAULT_KEY=
ONBOARDING_TOKEN_SECRET=

# Optional: use only if the matching integration is enabled.
# RESEND_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# WHATSAPP_API_TOKEN=
# EXOTEL_API_KEY=

# Legacy alternative to the publishable key above; do not set both:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
